# PayPal (PayPal + carte bancaire sans compte)
# Créer une app sur https://developer.paypal.com/dashboard/
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=votre_client_id
PAYPAL_CLIENT_SECRET=votre_client_secret
NEXT_PUBLIC_PAYPAL_CLIENT_ID=votre_client_id

# URL publique du site — IMPORTANT en production.
# Sert de base aux balises Open Graph, canonical et au sitemap.
# En local : http://localhost:3000  /  En production : https://veronique-kaba.fr
NEXT_PUBLIC_SITE_URL=https://veronique-kaba.fr

# Espace élèves — comptes individuels gérés par Supabase (projet
# « veronique-kaba-formation »). Véronique crée les comptes depuis /formation/admin.
NEXT_PUBLIC_SUPABASE_URL=https://tfkaretrodrbmwtutvvu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_PA815turu4CoirMxuOn4pw_BKU9fJHU
# Clé SECRÈTE (Supabase > Project Settings > API Keys > Secret keys).
# Serveur uniquement : à renseigner dans Netlify, jamais dans le code.
SUPABASE_SECRET_KEY=

# Prise de rendez-vous en ligne — coller le lien de l'agenda Calendly ou Cal.com.
# Ex. Calendly : https://calendly.com/veronique-kaba/seance
# Ex. Cal.com  : https://cal.com/veronique-kaba/seance
# Si vide, la page /rendez-vous affiche seulement le formulaire + téléphone/WhatsApp.
NEXT_PUBLIC_BOOKING_URL=

# Contact form : géré par Netlify Forms, aucune variable requise.
# Les soumissions arrivent dans Netlify > Forms > "contact".
# Pour être notifiée par e-mail : Netlify > Forms > Form notifications
# > Add notification > Email notification (l'adresse peut être n'importe
# laquelle — elle n'a pas besoin d'être sur le domaine du site).
