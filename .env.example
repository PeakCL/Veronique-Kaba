# PayPal (PayPal + carte bancaire sans compte)
# Créer une app sur https://developer.paypal.com/dashboard/
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=votre_client_id
PAYPAL_CLIENT_SECRET=votre_client_secret
NEXT_PUBLIC_PAYPAL_CLIENT_ID=votre_client_id

# URL publique du site — IMPORTANT en production.
# Sert de base aux balises Open Graph, canonical et au sitemap.
# En local : http://localhost:3000  /  En production : https://veronique-kaba.fr
NEXT_PUBLIC_SITE_URL=https://veronique-kaba.fr

# Espace formation (mot de passe simple — remplacer en prod par auth robuste)
FORMATION_ACCESS_PASSWORD=energie-doree-2026

# Calendly (prise de RDV) — URL d'embed
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/votre-compte

# Contact form (optionnel: Resend, etc.)
CONTACT_EMAIL=contact@veronique-et-lenergie-doree.fr
